<mxfile host="drawio">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Lanes -->
        <mxCell id="laneB" value="Browser" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="660" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="laneT" value="Training (Python)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4faf2;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="20" width="500" height="520" as="geometry"/>
        </mxCell>

        <!-- Browser: input + preprocessing -->
        <mxCell id="canvas" value="&lt;b&gt;&amp;lt;canvas&amp;gt;&lt;/b&gt;&lt;br&gt;pointer events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="75" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="prepTS" value="&lt;b&gt;Preprocessing (TS)&lt;/b&gt;&lt;br&gt;RDP simplify → stroke-5 → normalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="300" height="60" as="geometry"/>
        </mxCell>

        <!-- Web worker -->
        <mxCell id="worker" value="Web Worker: ONNX Runtime Web" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="275" width="620" height="365" as="geometry"/>
        </mxCell>
        <mxCell id="lstm" value="&lt;b&gt;Encoder&lt;/b&gt;&lt;br&gt;causal LSTM&lt;br&gt;&lt;i&gt;hidden state h&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="clshead" value="&lt;b&gt;Class head&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="325" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="mdnhead" value="&lt;b&gt;MDN head&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="420" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="clsemb" value="class c&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(top-k guesses)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="500" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="pclass" value="p(class | strokes so far)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pnext" value="p(next point | prefix, class)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="415" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ghostsamp" value="&lt;b&gt;Ghost sampling&lt;/b&gt;&lt;br&gt;autoregressive, T ≈ 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="545" width="190" height="55" as="geometry"/>
        </mxCell>

        <!-- UI -->
        <mxCell id="ui" value="UI" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="620" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="uicanvas" value="canvas +&lt;br&gt;ghost strokes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="735" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="uibelief" value="belief chart&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;p(class) + entropy per stroke&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="735" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="uidecided" value="&quot;decided here&quot;&lt;br&gt;marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="735" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Training -->
        <mxCell id="qd" value="&lt;b&gt;Quick, Draw!&lt;/b&gt; (ndjson)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;10 classes, ~1.5M drawings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="75" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="prepPy" value="&lt;b&gt;Preprocessing (Py)&lt;/b&gt;&lt;br&gt;stroke-5 → normalize → augment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="170" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="torch" value="&lt;b&gt;PyTorch model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;class CE (every step) + MDN NLL + pen CE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="onnx" value="&lt;b&gt;export → model.onnx&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="410" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Edges: browser -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="canvas" target="prepTS">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="stroke-5 point" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=none;align=left;spacingLeft=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prepTS" target="lstm">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <Array as="points"><mxPoint x="220" y="318"/><mxPoint x="145" y="318"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="h&lt;sub&gt;t&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#fff8e1;exitX=1;exitY=0.25;" edge="1" parent="1" source="lstm" target="clshead">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="h&lt;sub&gt;t&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#fff8e1;exitX=1;exitY=0.75;" edge="1" parent="1" source="lstm" target="mdnhead">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="clsemb" target="mdnhead">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="clshead" target="pclass">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="mdnhead" target="pnext">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="pnext" target="ghostsamp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="feed sampled point back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.2;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#fff8e1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="ghostsamp" target="lstm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="145" y="572"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="top-k" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.2;dashed=1;fontSize=11;labelBackgroundColor=#fff8e1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="pclass" target="clsemb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="545" y="390"/><mxPoint x="425" y="390"/><mxPoint x="425" y="522"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="pclass" target="uibelief">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="650" y="345"/><mxPoint x="650" y="665"/><mxPoint x="355" y="665"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;" edge="1" parent="1" source="ghostsamp" target="uicanvas">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="497" y="655"/><mxPoint x="145" y="655"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="uibelief" target="uidecided">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges: training -->
        <mxCell id="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="qd" target="prepPy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="prepPy" target="torch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="torch" target="onnx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cross-lane -->
        <mxCell id="x1" value="MUST BE IDENTICAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;strokeColor=#d32f2f;fontColor=#d32f2f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="prepTS" target="prepPy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="loaded at startup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.438;" edge="1" parent="1" source="onnx" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
